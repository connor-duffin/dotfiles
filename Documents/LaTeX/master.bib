@article{risbey2009remote,
  title = {On the {{Remote Drivers}} of {{Rainfall Variability}} in {{Australia}}},
  author = {Risbey, James S. and Pook, Michael J. and McIntosh, Peter C. and Wheeler, Matthew C. and Hendon, Harry H.},
  year = {2009},
