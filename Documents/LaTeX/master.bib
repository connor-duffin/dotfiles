  primaryclass = {math, stat},
  abstract = {In this paper, we consider an infinite dimensional exponential family, \$\textbackslash mathcal\{P\}\$ of probability densities, which are parametrized by functions in a reproducing kernel Hilbert space, \$H\$ and show it to be quite rich in the sense that a broad class of densities on \$\textbackslash mathbb\{R\}\^d\$ can be approximated arbitrarily well in Kullback-Leibler (KL) divergence by elements in \$\textbackslash mathcal\{P\}\$. The main goal of the paper is to estimate an unknown density, \$p\_0\$ through an element in \$\textbackslash mathcal\{P\}\$. Standard techniques like maximum likelihood estimation (MLE) or pseudo MLE (based on the method of sieves), which are based on minimizing the KL divergence between \$p\_0\$ and \$\textbackslash mathcal\{P\}\$, do not yield practically useful estimators because of their inability to efficiently handle the log-partition function. Instead, we propose an estimator, \$\textbackslash hat\{p\}\_n\$ based on minimizing the \textbackslash emph\{Fisher divergence\}, \$J(p\_0\textbackslash Vert p)\$ between \$p\_0\$ and \$p\textbackslash in \textbackslash mathcal\{P\}\$, which involves solving a simple finite-dimensional linear system. When \$p\_0\textbackslash in\textbackslash mathcal\{P\}\$, we show that the proposed estimator is consistent, and provide a convergence rate of \$n\^\{-\textbackslash min\textbackslash left\textbackslash\{\textbackslash frac\{2\}\{3\},\textbackslash frac\{2\textbackslash beta+1\}\{2\textbackslash beta+2\}\textbackslash right\textbackslash\}\}\$ in Fisher divergence under the smoothness assumption that \$\textbackslash log p\_0\textbackslash in\textbackslash mathcal\{R\}(C\^\textbackslash beta)\$ for some \$\textbackslash beta\textbackslash ge 0\$, where \$C\$ is a certain Hilbert-Schmidt operator on \$H\$ and \$\textbackslash mathcal\{R\}(C\^\textbackslash beta)\$ denotes the image of \$C\^\textbackslash beta\$. We also investigate the misspecified case of \$p\_0\textbackslash notin\textbackslash mathcal\{P\}\$ and show that \$J(p\_0\textbackslash Vert\textbackslash hat\{p\}\_n)\textbackslash rightarrow \textbackslash inf\_\{p\textbackslash in\textbackslash mathcal\{P\}\}J(p\_0\textbackslash Vert p)\$ as \$n\textbackslash rightarrow\textbackslash infty\$, and provide a rate for this convergence under a similar smoothness condition as above. Through numerical simulations we demonstrate that the proposed estimator outperforms the non-parametric kernel density estimator, and that the advantage with the proposed estimator grows as \$d\$ increases.},
  archiveprefix = {arXiv},
  keywords = {Mathematics - Statistics Theory,Statistics - Machine Learning,Statistics - Methodology},
  file = {/Users/connor/Zotero/storage/SF63TALV/Sriperumbudur et al. - 2017 - Density Estimation in Infinite Dimensional Exponen.pdf;/Users/connor/Zotero/storage/HNSYXI7N/1312.html}
