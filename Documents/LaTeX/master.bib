  shorttitle = {How Did Ocean Warming Affect {{Australian}} Rainfall Extremes during the 2010/2011 {{La Ni\~na}} Event?},
  author = {Ummenhofer, Caroline C. and Sen Gupta, Alexander and England, Matthew H. and Taschetto, Andr{\'e}a S. and Briggs, Peter R. and Raupach, Michael R.},
