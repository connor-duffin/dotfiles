r <- getOption("repos")
r["CRAN"] <- "https://cloud.r-project.org/"
options(repos = r)
rm(r)

options(
  warnPartialMatchDollar = TRUE,
  stringsAsFactors = FALSE,
  prompt = "R > ",
  width = 120,
  browserNLdisabled = TRUE,
  lintr.linter_file = "~/.lintr"
)

clear <- function() {system("clear")}

